# ==========================================
# Adaptive Interview Intelligence - Configuration
# ==========================================

# Application
PROJECT_NAME="Adaptive Interview Intelligence"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="127.0.0.1"
FRONTEND_URL="http://127.0.0.1:5173"

# Database Configuration (PostgreSQL by default, SQLite fallback supported)
# PostgreSQL connection string:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/adaptive_interview
DATABASE_URL=sqlite:///./adaptive_interview.db

# Authentication / Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Transactional Email Service (SMTP)
# Configure these for real email delivery of confirmed interview schedules & invitations
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_EMAIL=interviews@adaptiveinterview.io
SMTP_ENABLED=false

# LLM Configuration (Backend only)
# Provider options: "gemini" or "openai"
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
# Alternative OpenAI configuration:
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Interview Configuration
MAX_QUESTIONS_PER_SESSION=5
MAX_RECOVERY_ATTEMPTS=2
# Time window configuration: early access tolerance (minutes before schedule) and duration window (minutes after schedule)
INTERVIEW_EARLY_ACCESS_MINUTES=15
INTERVIEW_WINDOW_MINUTES=90
